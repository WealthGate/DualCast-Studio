{
  "name": "openchurch-broadcast-studio",
  "version": "0.6.38",
  "private": true,
  "description": "Open church production, presentation, recording, and multi-destination streaming studio",
  "author": {
    "name": "WealthGate",
    "email": "50961398+WealthGate@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WealthGate/DualCast-Studio.git"
  },
  "homepage": "https://github.com/WealthGate/DualCast-Studio",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite --port 5173 --strictPort",
    "dev:main": "tsup --watch",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 nodemon --watch dist-electron --exec \"electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsup && vite build",
    "package": "npm run prepare:windows-capture && npm run prepare:audio-host && npm run prepare:virtual-camera && npm run build && electron-builder",
    "test": "vitest run",
    "verify:streaming": "node scripts/verify-streaming.cjs",
    "verify:stream-startup": "node scripts/verify-stream-startup.cjs --encoder=x264 --ci && node scripts/verify-stream-startup.cjs --encoder=x264 --ci --copy-video",
    "prepare:windows-capture": "node scripts/prepare-windows-capture.cjs",
    "prepare:audio-host": "node scripts/build-audio-host.cjs",
    "verify:audio-host": "node scripts/verify-audio-host.cjs",
    "verify:audio-fidelity": "node scripts/verify-audio-fidelity.cjs",
    "verify:audio-plugin-bridge": "node scripts/verify-audio-plugin-bridge.cjs",
    "verify:audio-plugin-ui": "node scripts/verify-audio-plugin-ui.cjs",
    "verify:live-output": "node scripts/verify-live-output.cjs",
    "verify:broadcast-continuity": "node scripts/verify-live-output.cjs --continuity-only",
    "verify:service-features": "node scripts/verify-live-output.cjs --service-features-only",
    "prepare:virtual-camera": "node scripts/build-virtual-camera.cjs",
    "verify:virtual-camera": "node scripts/verify-virtual-camera.cjs && node scripts/verify-virtual-camera-ui.cjs",
    "verify:backgrounds": "node scripts/verify-app-backgrounds.cjs"
  },
  "dependencies": {
    "electron-log": "^5.1.2",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "41.10.6",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.dualcast.studio",
    "productName": "OpenChurch Broadcast Studio",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "dist-electron/**",
      "dist/renderer/**",
      "assets/icon.png",
      "assets/OpenChurch-Broadcast-Studio-User-Guide.pdf",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "WealthGate",
        "repo": "DualCast-Studio"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "win": {
      "extraResources": [
        {
          "from": "assets/windows-capture",
          "to": "windows-capture"
        },
        {
          "from": "assets/audio-host",
          "to": "audio-host"
        },
        {
          "from": "assets/virtual-camera",
          "to": "virtual-camera"
        }
      ],
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
